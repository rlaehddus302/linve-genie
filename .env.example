# 환경변수 목록 (AC-S00-07). 실제 값은 같은 폴더의 .env에 둔다(.env는 커밋하지 않는다).
# 비밀값을 이 파일에 적지 않는다.

# 서버가 기다릴 포트. 비우면 3000. (apps/server)
PORT=

# ── S04 서버 (apps/server) ─────────────────────────────────────────────
# 운영 데이터베이스(PostgreSQL) 연결 문자열. 운영 시작에는 필수다(없으면 시작하지 않는다).
DATABASE_URL=
# 개발용 파일 데이터베이스(PGlite) 폴더. DATABASE_URL 대신 명시적으로 고를 때만 쓴다(둘 중 하나만).
LIVEJJIM_PGLITE_DIR=
# 서버 마스터 키: 32바이트를 base64로. 판매자 전화번호 키를 암호화한다. 잃으면 이후 문자찜이 이전 문자 구매자와 이어지지 않는다.
# 만들기: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
LIVEJJIM_MASTER_KEY=
# 화면 앱 주소(경로 없이). 상태를 바꾸는 요청의 Origin이 이 값과 같아야 한다. 예: https://app.example.com
LIVEJJIM_APP_ORIGIN=

# ── Y1 유튜브 연동 (apps/server) ────────────────────────────────────────
# 구글 클라우드 프로젝트의 OAuth 클라이언트(D-019, 사용자 몫). 클라이언트 ID가 비어 있으면 유튜브 연동을 하지 않는다.
LIVEJJIM_GOOGLE_CLIENT_ID=
LIVEJJIM_GOOGLE_CLIENT_SECRET=
# 구글에 등록한 돌아오는 주소 하나. 예: https://app.example.com/api/youtube/oauth/callback (https만)
LIVEJJIM_GOOGLE_REDIRECT_URI=
# 연결을 마친 뒤 판매자를 보낼 화면 주소 (없으면 <앱 주소>/settings/youtube, 결과는 ?youtube=코드)
LIVEJJIM_YOUTUBE_RETURN_URL=
# 할당량: 프로젝트 하루 한도(기본 10000)·판매자별 하루 예산(기본 = 한도)
LIVEJJIM_YOUTUBE_QUOTA_LIMIT=
LIVEJJIM_YOUTUBE_SELLER_BUDGET=
# 바깥 주소 (보통 비워 둔다 — 구글 기본값. https만)
LIVEJJIM_GOOGLE_AUTH_URL=
LIVEJJIM_GOOGLE_TOKEN_URL=
LIVEJJIM_GOOGLE_REVOKE_URL=
LIVEJJIM_YOUTUBE_API_URL=

# ── I3 배포·운영 (apps/server, docs/DEPLOY.md) ───────────────────────────
# 화면 빌드 폴더(index.html이 있는 곳). 적으면 서버가 화면을 같은 출처로 함께 낸다. 컨테이너 이미지는 /app/apps/web/dist로 정해 둔다.
LIVEJJIM_WEB_DIR=
# 운영 상태 /ops/status를 여는 토큰(32자 이상). 비우면 /ops/status는 없다(404).
# 만들기: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
LIVEJJIM_OPS_TOKEN=
# 서버 앞의 믿는 프록시 수(0~5, 기본 0). 로그인 IP 한도가 X-Forwarded-For의 오른쪽에서 이 번째 주소를 본다. 프록시가 없으면 비우거나 0.
LIVEJJIM_TRUSTED_PROXIES=
# 백업 폴더(미리 만들어 둔다): 백업 명령(backup)의 데이터베이스 전체 덤프(livejjim-*.dump, I3)와 서버의 매일 판매자 자동 백업(판매자마다 하위 폴더, I2 — 비우면 자동 백업이
# 꺼진다: 시작 경보, 판매는 그대로. 복구 명령의 안전 백업도 여기에 쓴다)을 함께 둔다. 그리고 pg_dump 경로(기본 pg_dump)
LIVEJJIM_BACKUP_DIR=
LIVEJJIM_PG_DUMP=
# 틱톡 라이브 베타(읽기 전용, D-904) 운영자 전체 스위치 — on일 때만 켠다(비우면 끔). 상용 출시 전 법률 검토 뒤에 켠다
LIVEJJIM_TIKTOK_BETA=
# 선택: 틱톡 서명 서비스 키(보통 비운다). 값은 로그·화면에 나오지 않는다.
# 두지 마세요: 틱톡 연결 라이브러리가 스스로 읽는 SIGN_API_URL·SIGN_API_KEY·WHITELIST_AUTHENTICATED_SESSION_ID_HOST.
# 하나라도 있으면 서버가 틱톡을 끈 것으로 보고 경고 TIKTOK_LIBRARY_ENV를 남긴다(N2b-2, D-N2b-2-06)
LIVEJJIM_TIKTOK_SIGN_API_KEY=
# ── N2 인스타그램 라이브 (apps/server, D-N2-06·D-N2-11) ──────────────────
# 메타 개발자 앱 값. 앱 ID·앱 시크릿·웹훅 확인 토큰·돌아오는 주소 중 하나라도 비면 인스타그램 기능은 꺼진다("연동이 아직 준비되지 않았어요", 웹훅 503).
# 앱 시크릿·확인 토큰은 비밀값이다(로그·응답에 나오지 않는다).
LIVEJJIM_IG_APP_ID=
LIVEJJIM_IG_APP_SECRET=
LIVEJJIM_IG_VERIFY_TOKEN=
# 메타 승인 뒤 돌아오는 이 서버의 공개 주소 (GET /api/instagram/callback). 예: https://api.example.com/api/instagram/callback
LIVEJJIM_IG_REDIRECT_URI=
# 로그인 방식: FACEBOOK(기본) 또는 INSTAGRAM
LIVEJJIM_IG_LOGIN=
# 권한 목록 덮어쓰기(쉼표 목록, 비우면 로그인 방식의 기본 권한)
LIVEJJIM_IG_SCOPES=
# 연결을 마친 뒤 돌아갈 화면 경로(기본 /). 화면 주소 = LIVEJJIM_APP_ORIGIN + 이 경로 + ?instagram=<결과 코드>
LIVEJJIM_IG_RETURN_PATH=
# 메타 주소 덮어쓰기(스테이징·시험용, 비우면 메타 주소): 그래프 API·인스타그램 그래프 API·승인 창·인스타그램 토큰 주소
LIVEJJIM_IG_GRAPH_URL=
LIVEJJIM_IG_IG_GRAPH_URL=
LIVEJJIM_IG_FB_DIALOG_URL=
LIVEJJIM_IG_IG_AUTHORIZE_URL=
LIVEJJIM_IG_IG_TOKEN_URL=

# ── N3 입금 확인 (apps/server) ─────────────────────────────────────────
# 팝빌 연동 키(계좌조회). 둘 다 있을 때만 계좌조회 원천을 만들 수 있다(없으면 "계좌 연동은 아직 준비 중이에요"). 실제 계약·발급은 사용자 몫.
# 계좌 비밀번호·빠른조회 비밀번호는 이 서비스가 받지 않는다 — 판매자가 팝빌 계좌 관리 화면에서 등록한다.
LIVEJJIM_POPBILL_LINK_ID=
LIVEJJIM_POPBILL_SECRET_KEY=
# 팝빌 테스트베드를 쓰면 true (운영은 비워 둔다)
LIVEJJIM_POPBILL_TEST_BED=

id: G-ENG-O1-07
title: 옵션 방송의 메시지 변환은 1등을 밀어내지 않는다(충돌 없음)
refs: [CMT-04, R-20, R-7, ORD-12]
settings: { claim.parseMode: OPTIONS }
broadcasts: [{ id: b1, date: 2026-10-25, title: 식품 2부 }]
events:
  - { at: "20:00:00", type: product.register, b: b1, no: 11, name: 초코 과자, price: 2000 }       # 재고 1
  - { at: "20:00:01", type: chat, b: b1, id: m1, ch: UC_B, nick: 김철수, text: "십일번이요" }      # 주문 아님(한글 수사), 언급도 없음
  - { at: "20:00:02", type: chat, b: b1, id: m2, ch: UC_A, nick: 홍길동, text: "11" }              # A 확정
  - { at: "20:00:30", type: host.convertMessage, b: b1, msg: m1, no: 11, reason: 십일번 }          # STRICT 방송이면 B가 앞서 충돌. 옵션 방송은 밀어내지 않고 순위 자리로 → 대기 1
expect:
  products:
    b1/11: { status: SOLD, winner: UC_A, waitlist: [UC_B], conflict: false }

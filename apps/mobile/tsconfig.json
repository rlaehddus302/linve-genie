// 휴대폰 앱(Expo) 타입 검사 (APP-01). 저장소 공통 엄격 설정을 물려받고 React Native 번들러 해석만 덮는다.
// 화면·라우트·시험·도구 설정 파일을 모두 검사한다 (AC-S00-03 "범위 안 어느 파일에든").
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "jsx": "react-jsx",
    "types": ["expo/types", "node"]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "*.ts", "*.mts"]
}

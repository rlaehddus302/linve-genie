// 휴대폰 앱(Expo) 타입 검사 (APP-01). 저장소 공통 엄격 설정을 물려받고 React Native 번들러 해석만 덮는다.
// 화면·라우트·시험·도구 설정 파일을 모두 검사한다 (AC-S00-03 "범위 안 어느 파일에든").
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "jsx": "react-jsx",
    "types": ["expo/types", "node"],
    // 그림 가져오기 타입(src/assets.ts — import·export가 없는 유일한 파일)을 전역 선언으로 읽게 "auto". 나머지 파일은 모두 import·export가 있어 그대로 모듈 (D-CI-01, SA-S00-011 선언 파일 금지)
    "moduleDetection": "auto"
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx", "*.ts", "*.mts"]
}

{
  "expo": {
    "name": "라이브지니",
    "slug": "livejjim-mobile",
    "version": "0.1.5",
    "scheme": "livejjim",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F8A4C"
    },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "app.livejjim.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "방송 중 사장님 말(상품 번호·가격)을 듣고 상품을 등록하려고 마이크를 써요.",
        "NSBluetoothAlwaysUsageDescription": "라벨 프린터에 연결해 라벨을 찍으려고 블루투스를 써요.",
        "NSBluetoothPeripheralUsageDescription": "라벨 프린터에 연결해 라벨을 찍으려고 블루투스를 써요.",
        "UIBackgroundModes": [
          "audio",
          "bluetooth-central"
        ],
        "CFBundleDevelopmentRegion": "ko"
      }
    },
    "android": {
      "package": "kr.livegenie.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F8A4C"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "./plugins/with-android-release",
      "expo-router",
      "expo-web-browser",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf",
            "./assets/fonts/Pretendard-ExtraBold.otf",
            "./assets/fonts/Pretendard-Black.otf"
          ]
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "neverForLocation": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "라벨 프린터에 연결해 라벨을 찍으려고 블루투스를 써요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "permissionWords": {
        "microphone": "방송 중 사장님 말(상품 번호·가격)을 듣고 상품을 등록하려고 마이크를 써요.",
        "bluetooth": "라벨 프린터에 연결해 라벨을 찍으려고 블루투스를 써요.",
        "notification": "음성 듣는 중이라는 알림을 보여 드리려고 해요."
      },
      "eas": {
        "projectId": ""
      }
    }
  }
}

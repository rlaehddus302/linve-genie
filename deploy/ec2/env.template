# 라이브지니 EC2 운영 환경 — bootstrap.sh가 /opt/livegenie/.env(권한 600)로 만든다. 저장소·로그에 값을 넣지 않는다.
# __이름__ 자리는 bootstrap.sh가 채운다. 다 만든 뒤에는 이 파일이 아니라 /opt/livegenie/.env를 고친다.
# 값에 $·따옴표·빈칸을 넣지 않는다(compose가 읽는다). 고친 뒤: sudo lg-compose up -d
# 표 전체와 뜻: docs/DEPLOY.md 2절

# ── 이 묶음(deploy/ec2)이 쓰는 값 ─────────────────────────────────────
# 주소. 도메인이 생기면 이 줄과 LIVEJJIM_APP_ORIGIN만 바꾸고 sudo lg-compose up -d (구글·밴드 등 돌아오는 주소도 함께)
LJ_DOMAIN=__LJ_DOMAIN__
# 매일 04:00(KST) DB 백업을 올릴 S3 버킷 이름(backup.sh)
LJ_BACKUP_BUCKET=__LJ_BACKUP_BUCKET__
# 내부망 PostgreSQL 비밀번호(db 서비스 첫 기동 때 정해진다 — 나중에 이 값만 바꾸면 접속이 끊긴다)
LJ_DB_PASSWORD=__LJ_DB_PASSWORD__

# ── 서버 필수 ────────────────────────────────────────────────────────
DATABASE_URL=postgres://livejjim:__LJ_DB_PASSWORD__@db:5432/livejjim
# 판매자 전화번호 키·구글 토큰 암호화. SSM __LG_SSM_PREFIX__/master-key 와 같아야 한다. 바꾸지 않는다(DEPLOY.md 7절)
LIVEJJIM_MASTER_KEY=__LIVEJJIM_MASTER_KEY__
LIVEJJIM_APP_ORIGIN=https://__LJ_DOMAIN__

# ── 운영 ─────────────────────────────────────────────────────────────
# /ops/status 토큰(SSM __LG_SSM_PREFIX__/ops-token)
LIVEJJIM_OPS_TOKEN=__LIVEJJIM_OPS_TOKEN__
# 앞단은 caddy 하나
LIVEJJIM_TRUSTED_PROXIES=1
# 서버 판매자 자동 백업 폴더(컨테이너 안 경로, 호스트 /opt/livegenie/backups/app)
LIVEJJIM_BACKUP_DIR=/backups

# ── 받아쓰기 일꾼(맥 미니) 연결 (DEPLOY.md 5절 "자체 받아쓰기 연결") ──────
# 일꾼은 wss://<LJ_DOMAIN>/api/voice/worker 로 붙고, 같은 값을 권한 0600 파일에 넣어 --token-file로 넘긴다.
# 값은 SSM __LG_SSM_PREFIX__/transcribe-worker-token 에서 꺼낸다. 화면·앱에는 넘기지 않는다.
LIVEJJIM_TRANSCRIBE_WORKER_TOKEN=__LIVEJJIM_TRANSCRIBE_WORKER_TOKEN__

# ── 유튜브 ───────────────────────────────────────────────────────────
# 서버가 방송 주소만으로 채팅 읽기(YT-11): 켬
LIVEJJIM_YT_WEB_CHAT=on
# 방송 소리로 듣기: 끔 — 클라우드 IP에서 유튜브 소리가 막힌다. 앱 마이크가 기본(D-LV1-11·D-LV1-12)
LIVEJJIM_STREAM_AUDIO=off
# 집 회선 프록시(D-LV1-13, deploy/home-proxy/README.md): 맥 미니 터널이 붙은 뒤에만 위를 on으로, 아래 # 를 지운다.
# yt-dlp와 ffmpeg가 모두 이 출구로 나간다. http://127.0.0.1·localhost·host.docker.internal:<포트>만 받는다(그 밖이면 쓰지 않고 경고 한 줄)
# LIVEJJIM_YT_MEDIA_PROXY=http://host.docker.internal:18888

# ── 선택 기능 (값을 받으면 # 를 지우고 채운다. 반쯤만 채우면 서버가 시작하지 않는 것도 있다) ──
# 유튜브 감사 채팅(구글 OAuth, DEPLOY.md 4절)
# LIVEJJIM_GOOGLE_CLIENT_ID=
# LIVEJJIM_GOOGLE_CLIENT_SECRET=
# LIVEJJIM_GOOGLE_REDIRECT_URI=https://__LJ_DOMAIN__/api/youtube/oauth/callback
# 간편 로그인(4-3절)
# LIVEJJIM_LOGIN_GOOGLE_CLIENT_ID=
# LIVEJJIM_LOGIN_GOOGLE_CLIENT_SECRET=
# LIVEJJIM_LOGIN_KAKAO_REST_API_KEY=
# LIVEJJIM_LOGIN_KAKAO_CLIENT_SECRET=
# LIVEJJIM_LOGIN_NAVER_CLIENT_ID=
# LIVEJJIM_LOGIN_NAVER_CLIENT_SECRET=
# AI 확인 필요 제안(4-5절)
# LIVEJJIM_ASSIST_API_KEY=
# 요금(N5) — 켜려면 요금 표·포트원 넷이 다 있어야 한다
LIVEJJIM_BILLING=off

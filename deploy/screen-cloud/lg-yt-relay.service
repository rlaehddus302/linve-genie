# lg-yt-relay.socket이 받은 연결을 맥 미니 터널 끝으로 넘긴다 (systemd 기본 도구, 새 꾸러미 없음)
[Unit]
Description=livegenie YouTube proxy relay (to home proxy tunnel)
Requires=lg-yt-relay.socket
After=lg-yt-relay.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --connections-max=64 172.17.0.1:18888
PrivateTmp=yes
